# Template only. scripts/bootstrap.sh creates .env from this file with random secrets
# (chmod 600). Never commit .env. Empty values below are filled by the script.

# Timezone for Frigate/Grafana (the host stays UTC)
TZ=Africa/Casablanca

# Where Frigate pulls the box streams from. Lab: box-sim. Real box: its NetBird tunnel IP.
BOX_HOST=box-sim
BOX_RTSP_USER=box
BOX_RTSP_PASSWORD=

# MQTT users (Mosquitto password file is generated from these by scripts/bootstrap.sh)
FRIGATE_MQTT_PASSWORD=
MQTT_INSIGHTS_PASSWORD=
MQTT_OPERATOR_PASSWORD=
MQTT_HEALTHCHECK_PASSWORD=

# TimescaleDB (insights)
POSTGRES_PASSWORD=
INSIGHTS_DB_PASSWORD=
GRAFANA_DB_PASSWORD=

# Grafana UI admin (used on first start only)
GRAFANA_ADMIN_PASSWORD=
