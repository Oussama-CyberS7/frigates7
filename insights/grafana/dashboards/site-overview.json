    {
      "id": 5,
      "type": "stat",
      "title": "Avg dwell at loading dock",
      "description": "Average time objects stayed in the loading_dock zone (closed visits)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "insights-tsdb"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "insights-tsdb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT avg(EXTRACT(EPOCH FROM (exit_time - enter_time))) FROM zone_visits WHERE site = '$site' AND camera IN ($camera) AND zone = 'loading_dock' AND exit_time IS NOT NULL AND $__timeFilter(enter_time)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
