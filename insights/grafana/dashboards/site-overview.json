      "type": "timeseries",
      "title": "Alerts vs detections (10 min)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "insights-tsdb"
      },
      "gridPos": {
        "x": 12,
