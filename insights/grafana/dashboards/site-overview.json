    {
      "id": 7,
      "type": "timeseries",
      "title": "Objects per hour",
      "description": "Tracked objects per hour by label (continuous aggregate, kept 400 days)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "insights-tsdb"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "insights-tsdb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT bucket AS time, label AS metric, sum(objects) AS value FROM objects_hourly WHERE site = '$site' AND camera IN ($camera) AND $__timeFilter(bucket) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
