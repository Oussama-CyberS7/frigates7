    {
      "id": 9,
      "type": "timeseries",
      "title": "Loading dock dwell per hour",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "insights-tsdb"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "insights-tsdb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT bucket AS time, 'avg dwell ' || label AS metric, avg(avg_dwell_s) AS value FROM zone_dwell_hourly WHERE site = '$site' AND camera IN ($camera) AND zone = 'loading_dock' AND $__timeFilter(bucket) GROUP BY 1, 2 UNION ALL SELECT bucket AS time, 'max dwell ' || label AS metric, max(max_dwell_s) AS value FROM zone_dwell_hourly WHERE site = '$site' AND camera IN ($camera) AND zone = 'loading_dock' AND $__timeFilter(bucket) GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
