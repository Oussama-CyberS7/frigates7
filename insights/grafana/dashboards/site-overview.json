      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "online": {
                  "color": "green",
                  "index": 0,
                  "text": "online"
                },
                "offline": {
                  "color": "red",
                  "index": 1,
                  "text": "offline"
                },
                "stopped": {
                  "color": "orange",
                  "index": 2,
                  "text": "stopped"
                }
