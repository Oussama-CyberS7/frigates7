      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "insights-tsdb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(start_time, '10m'), severity AS metric, count(*) AS value FROM review_items WHERE site = '$site' AND camera IN ($camera) AND $__timeFilter(start_time) GROUP BY 1, 2 ORDER BY 1"
