    {
      "id": 10,
      "type": "table",
      "title": "Loading dock: latest visits",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "insights-tsdb"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "insights-tsdb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT enter_time AS \"Entered\", exit_time AS \"Left\", camera AS \"Camera\", label AS \"Object\", round(dwell_s::numeric, 1) AS \"Dwell (s)\", in_zone_now AS \"In zone now\" FROM zone_visits_v WHERE site = '$site' AND camera IN ($camera) AND zone = 'loading_dock' AND $__timeFilter(enter_time) ORDER BY enter_time DESC LIMIT 50"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Recent alerts",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "insights-tsdb"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "insights-tsdb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT start_time AS \"Start\", camera AS \"Camera\", array_to_string(objects, ', ') AS \"Objects\", array_to_string(zones, ', ') AS \"Zones\", round(EXTRACT(EPOCH FROM (coalesce(end_time, now()) - start_time))::numeric, 0) AS \"Duration (s)\" FROM review_items WHERE site = '$site' AND camera IN ($camera) AND severity = 'alert' AND $__timeFilter(start_time) ORDER BY start_time DESC LIMIT 50"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Box health: detector",
      "description": "From <site>/stats every 60 s: detector inference speed and detections per second",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "insights-tsdb"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "insights-tsdb"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT time, 'inference (ms)' AS metric, inference_ms AS value FROM frigate_stats WHERE site = '$site' AND $__timeFilter(time) UNION ALL SELECT time, 'detection fps' AS metric, detection_fps AS value FROM frigate_stats WHERE site = '$site' AND $__timeFilter(time) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 1,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
